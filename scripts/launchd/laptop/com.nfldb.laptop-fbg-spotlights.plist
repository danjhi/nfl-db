<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Daily scrape of footballguys.com Player Spotlight articles into
         spotlight_articles. LAPTOP-primary. Runs 13:50, after the 13:40
         news scrape and before the 14:00 health check. NO date gate.
         Idempotent (insert-only on url), so re-runs and missed days are
         free; the whole 2026 listing is one page, self-healing. -->
    <key>Label</key>
    <string>com.nfldb.laptop-fbg-spotlights</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/danielhindery/dev/nfl-db/.venv/bin/python3</string>
        <string>-u</string>
        <string>-c</string>
        <string>
import os, datetime, signal
signal.alarm(600)  # 10-min wall-clock cap
os.chdir('/Users/danielhindery/dev/nfl-db')
print(f"{datetime.datetime.now()}: [laptop] Starting FBG Player Spotlight scrape...")
__file__ = 'scripts/news/fetch_fbg_spotlights.py'
import sys; sys.argv = [__file__]
exec(compile(open(__file__).read(), __file__, 'exec'))
print(f"{datetime.datetime.now()}: Done.")
        </string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/danielhindery/dev/nfl-db/data/logs/fbg_spotlights.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielhindery/dev/nfl-db/data/logs/fbg_spotlights.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
