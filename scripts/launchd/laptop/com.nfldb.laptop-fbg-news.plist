<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nfldb.laptop-fbg-news</string>

    <!-- Daily scrape of footballguys.com/updates 'News and Notes' into
         news_items (status='draft' for review). LAPTOP-primary. Runs 13:40,
         before the 14:00 health check. NO date gate — news runs year-round
         (unlike the draft-season ADP jobs). Idempotent (insert-only on
         source_url). --limit 7 self-heals a missed day. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/danielhindery/dev/nfl-db/.venv/bin/python3</string>
        <string>-u</string>
        <string>-c</string>
        <string>
import os, datetime, signal
signal.alarm(600)  # 10-min wall-clock cap
os.chdir('/Users/danielhindery/dev/nfl-db')
print(f"{datetime.datetime.now()}: [laptop] Starting FBG /updates news scrape...")
__file__ = 'scripts/news/fetch_fbg_news.py'
import sys; sys.argv = [__file__, '--limit', '7']
exec(compile(open(__file__).read(), __file__, 'exec'))
print(f"{datetime.datetime.now()}: Done.")
        </string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/danielhindery</string>
        <key>SSL_CERT_FILE</key>
        <string>/Users/danielhindery/dev/nfl-db/.venv/lib/python3.11/site-packages/certifi/cacert.pem</string>
        <key>REQUESTS_CA_BUNDLE</key>
        <string>/Users/danielhindery/dev/nfl-db/.venv/lib/python3.11/site-packages/certifi/cacert.pem</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/danielhindery/dev/nfl-db/data/logs/fbg_news.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielhindery/dev/nfl-db/data/logs/fbg_news.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
