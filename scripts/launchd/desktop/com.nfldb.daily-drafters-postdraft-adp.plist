<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nfldb.daily-drafters-postdraft-adp</string>

    <!-- LAPTOP redundancy copy of the Desktop's com.nfldb.daily-drafters-postdraft-adp.
         Runs at 13:00 (Desktop runs at 08:25). Idempotent merge-duplicates upsert, so
         the two machines harmlessly overwrite the same day's rows. Uses the nfl-db venv
         (system python3 here lacks deps); script self-loads .env. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/danielhindery/dev/nfl-db/.venv/bin/python3</string>
        <string>-u</string>
        <string>-c</string>
        <string>
import os, sys, datetime, signal
signal.alarm(600)  # 10-min wall-clock cap
os.chdir('/Users/danielhindery/dev/nfl-db')
today = datetime.date.today().strftime('%Y%m%d')
if today &lt; '20260427' or today &gt; '20260910':
    print(f"{datetime.datetime.now()}: Outside date range ({today}), skipping.")
    sys.exit(0)
print(f"{datetime.datetime.now()}: [desktop] Starting Drafters POST-DRAFT ADP fetch...")
__file__ = 'scripts/adp/fetch_drafters_postdraft_adp.py'
exec(compile(open(__file__).read(), __file__, 'exec'))
print(f"{datetime.datetime.now()}: Done.")
        </string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/danielhindery</string>
        <key>SSL_CERT_FILE</key>
        <string>/Users/danielhindery/dev/nfl-db/.venv/lib/python3.11/site-packages/certifi/cacert.pem</string>
        <key>REQUESTS_CA_BUNDLE</key>
        <string>/Users/danielhindery/dev/nfl-db/.venv/lib/python3.11/site-packages/certifi/cacert.pem</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/danielhindery/dev/nfl-db/data/logs/drafters_postdraft_adp.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielhindery/dev/nfl-db/data/logs/drafters_postdraft_adp.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
